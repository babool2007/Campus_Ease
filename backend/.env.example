# CampusEase Backend Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI (Replace with your Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/campusease?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=campusease_super_secret_key_2026

# Optional Cloud LLM (OpenAI / Gemini)
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# Production Frontend URL (e.g., https://campusease.vercel.app)
FRONTEND_URL=
